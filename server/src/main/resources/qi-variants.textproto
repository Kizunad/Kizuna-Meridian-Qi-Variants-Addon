# 正式内容的唯一编辑入口；颜色为占位展示值，不定义战斗效果。
schema_version: 1
attributes {
  id: "qi_variants:withering"
  display_name: "枯"
  color_rgb: 0x8D7C3C
}
attributes {
  id: "qi_variants:wither"
  display_name: "凋零"
  color_rgb: 0x4A3A57
